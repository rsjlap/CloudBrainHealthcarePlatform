# 生产环境变量示例 — 复制为 backend.env 后按需修改
# Linux: set -a && source backend.env && set +a && java -jar ...

SPRING_PROFILES_ACTIVE=prod

# 数据库（必填）
DB_URL=jdbc:mysql://127.0.0.1:3306/cloud_brain_medical?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
DB_USER=root
DB_PASSWORD=your_password

# JWT（生产务必更换）
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# 服务监听（默认仅本机，由 Nginx 反代）
SERVER_PORT=8081
SERVER_ADDRESS=127.0.0.1

# CORS：Nginx 同源反代时保持 false
CORS_ENABLED=false

# AI（DeepSeek 等）
AI_ENABLED=true
AI_API_KEY=sk-your-key
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat

# 知识图谱（可选）
KG_ENABLED=false
KG_BASE_URL=http://127.0.0.1:5000

# 讯飞语音（可选）
SPEECH_ENABLED=false
IFLYTEK_APP_ID=
IFLYTEK_API_KEY=
IFLYTEK_API_SECRET=

# API 文档（生产建议 false）
SWAGGER_ENABLED=false
