# ============================================================
# 给「非 MySQL 主机」的组员复制为 .env 使用
# MySQL 在组长电脑上时，把下面的 YOUR_MYSQL_HOST_IP 换成组长 ipconfig 的 IPv4
# 例如：172.18.244.27
# ============================================================

DB_URL=jdbc:mysql://YOUR_MYSQL_HOST_IP:3306/cloud_brain_medical?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
DB_USER=cloud_team
DB_PASSWORD=cloud123456

JWT_SECRET=cloud-brain-medical-jwt-secret-key-256bits-minimum-length

AI_ENABLED=true
AI_API_KEY=your_deepseek_api_key
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat

KG_ENABLED=true
KG_BASE_URL=http://KG服务IP:5000
KG_API_MODE=legacy
