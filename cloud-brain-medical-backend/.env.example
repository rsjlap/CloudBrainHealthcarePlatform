# ============================================================
# 本机（MySQL 主机）开发配置 — 复制为 .env 可选，默认 dev.yml 已够用
# ============================================================
DB_URL=jdbc:mysql://localhost:3306/cloud_brain_medical?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
DB_USER=root
DB_PASSWORD=123456

# 组员请用 .env.team.example（连你的 IP + cloud_team 账号）

# JWT
JWT_SECRET=your-256-bit-secret-key-change-in-production-please

# AI（DeepSeek，OpenAI 兼容接口）
AI_ENABLED=true
AI_API_KEY=your_deepseek_api_key
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
